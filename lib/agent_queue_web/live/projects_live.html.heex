<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold">Projects</h1>
    <div class="flex gap-2">
      <button
        phx-click="start_discovery"
        class={"btn btn-sm btn-primary #{if @discoverer_status.discovering, do: "btn-disabled", else: ""}"}
        disabled={@discoverer_status.discovering}
        title="Will scan up to #{@max_projects} projects, prioritized by: #{@priority_mode}"
      >
        <%= if @discoverer_status.discovering do %>
          <span class="loading loading-spinner loading-xs mr-2"></span> Discovering...
        <% else %>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 mr-1"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          Discover
        <% end %>
      </button>
      <.link navigate={~p"/tasks"} class="btn btn-sm btn-outline">
        View Tasks
      </.link>
      <.link navigate={~p"/settings"} class="btn btn-sm btn-outline">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 mr-1"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
          />
        </svg>
        Settings
      </.link>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="table table-zebra">
      <thead>
        <tr>
          <th>Name</th>
          <th>Path</th>
          <th>Last Scanned</th>
          <th>Status</th>
          <th>Tasks</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <%= for project <- @projects do %>
          <% stats = Map.get(@task_stats, project.id, %{}) %>
          <tr>
            <td class="font-medium">{project.name}</td>
            <td class="text-sm text-base-content/70">{project.path}</td>
            <td>{format_datetime(project.last_scanned)}</td>
            <td>
              <%= if project.enabled do %>
                <span class="badge badge-success">Enabled</span>
              <% else %>
                <span class="badge badge-error">Disabled</span>
              <% end %>
            </td>
            <td>
              <div class="flex flex-wrap gap-1">
                <span class="badge badge-ghost badge-sm whitespace-nowrap">
                  Proposed: {get_stat(stats, "proposed")}
                </span>
                <span class="badge badge-info badge-sm whitespace-nowrap">
                  Approved: {get_stat(stats, "approved")}
                </span>
                <span class="badge badge-warning badge-sm whitespace-nowrap">
                  Review: {get_stat(stats, "review")}
                </span>
                <span class="badge badge-success badge-sm whitespace-nowrap">
                  Completed: {get_stat(stats, "completed")}
                </span>
              </div>
            </td>
            <td>
              <div class="flex gap-2">
                <button
                  phx-click="toggle_enabled"
                  phx-value-id={project.id}
                  class="btn btn-sm btn-outline"
                >
                  {if project.enabled, do: "Disable", else: "Enable"}
                </button>
                <button
                  phx-click="delete_project"
                  phx-value-id={project.id}
                  class="btn btn-sm btn-error btn-outline"
                  data-confirm="Are you sure you want to delete this project and all its tasks?"
                >
                  Delete
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= if @projects == [] do %>
    <div class="text-center py-12 text-base-content/50">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-16 w-16 mx-auto mb-4"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
        />
      </svg>
      <p class="text-lg">No projects yet</p>
      <p class="text-sm">
        Click the "Discover" button to scan for projects
      </p>
    </div>
  <% end %>
</div>
